// Per-machine signing, identity, and OAuth configuration.
//
// This committed file holds the defaults used on the maintainer's primary machine. To build under a
// different developer account, bundle prefix, or OAuth credentials, DO NOT edit this file — create
// `Config/Triton.local.xcconfig` (gitignored) overriding the relevant settings below (see
// Config/Triton.local.xcconfig.example for a template).
//
// `TRITON_BUNDLE_PREFIX` is the reverse-DNS organisation prefix (everything before `.OMG`); it drives
// the app's bundle identifier. `OMGLOL_CLIENT_ID`, `OMGLOL_CLIENT_SECRET`, and `OMGLOL_REDIRECT_URI`
// are the OMG.LOL OAuth application credentials read at runtime from Info.plist. All three OAuth
// settings must be filled in `Triton.local.xcconfig` for authentication to work.
//
// `Triton.local.xcconfig` is included optionally at the end, so it overrides any setting when present
// and is simply absent on the maintainer's primary machine.

TRITON_BUNDLE_PREFIX = cc.otavio
DEVELOPMENT_TEAM = S9X9XY5GF8

OMGLOL_CLIENT_ID =
OMGLOL_CLIENT_SECRET =
OMGLOL_REDIRECT_URI =

#include? "Triton.local.xcconfig"
